---
import { siteConfig } from '../../data/config'
import { navItems } from '../../data/navigation'
import { getUrl } from '../../utils/url'
---

<footer class="footer-aspros">
  <div class="container">
    <div class="row g-5">
      <div class="col-lg-4">
        <div class="footer-logo">
          <img src={getUrl(siteConfig.logoUrl)} alt={siteConfig.nombre} />
        </div>
        <p class="mb-4">{siteConfig.frase}</p>
        <div class="footer-social">
          {siteConfig.redes.map(red => (
            <a href={red.url} target="_blank" rel="noopener noreferrer" aria-label={red.nombre}>
              <i class={`fab fa-${red.icono}`}></i>
            </a>
          ))}
        </div>
      </div>

      <div class="col-lg-4 col-md-4">
        <h5 class="footer-title">Contacto</h5>
        <ul class="list-unstyled">
          <li class="mb-2">
            <a href={`tel:${siteConfig.telefono}`}>
              <i class="fas fa-phone-alt me-2"></i> {siteConfig.telefono}
            </a>
          </li>
          <li class="mb-2">
            <a href={`mailto:${siteConfig.email}`}>
              <i class="fas fa-envelope me-2"></i> {siteConfig.email}
            </a>
          </li>
          <li class="mb-2">
            <i class="fas fa-map-marker-alt me-2"></i> {siteConfig.direccion}
          </li>
        </ul>
      </div>
      <div class="col-lg-4 col-md-4">
        <h5 class="footer-title">Servicios</h5>
        <ul class="list-unstyled">
          <li class="mb-2"><a href={getUrl('/hablemos')}>Solicitar cotización</a></li>
          <li class="mb-2"><a href={getUrl('/hibridos')}>Buscar híbrido ideal</a></li>
          <li class="mb-2"><a href={getUrl('/resultados')}>Ver resultados en campo</a></li>
          <li class="mb-2"><a href={getUrl('/bolsa-de-trabajo')}>Únete al equipo</a></li>
          <li class="mb-2"><a href={`mailto:${siteConfig.email}`}>Atención a clientes</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom text-center">
      <p class="mb-0">&copy; {new Date().getFullYear()} {siteConfig.nombre}. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
