---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getUrl } from '../utils/url'
---

<BaseLayout title="Página no encontrada">
  <section class="section-padding" style="min-height: 60vh;">
    <div class="container text-center">
      <h1 class="display-1 fw-bold text-green-dark mb-3">404</h1>
      <h2 class="h3 mb-4">Página no encontrada</h2>
      <p class="lead text-muted mb-5">La página que buscas no existe o ha sido movida.</p>
      <a href={getUrl('/')} class="btn btn-gold btn-lg">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>
