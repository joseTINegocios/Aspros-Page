---
import BaseLayout from '../layouts/BaseLayout.astro'
import { historiaPage } from '../data/historia'
import { getUrl } from '../utils/url'
---

<BaseLayout
  title="Nuestra Historia"
  description="Conoce la historia, propósito y capacidades de Aspros Semillas. Más de 40 años de experiencia en el campo mexicano."
  breadcrumbs={[{ label: 'Nuestra Historia' }]}
>
  <section class="section-padding pb-0">
    <div class="container">
      <h1 class="section-title">{historiaPage.heroTitle}</h1>
      <p class="lead text-center mb-0">{historiaPage.heroDesc}</p>
    </div>
  </section>

  <!-- Historia sections -->
  {historiaPage.sections.map(s => (
    <section class="section-padding" data-aos="fade-up">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-8">
            <div class="d-flex align-items-start gap-3 mb-4">
              <div class="flex-shrink-0">
                <div class="d-flex align-items-center justify-content-center rounded-circle bg-green-dark text-white" style="width: 56px; height: 56px;">
                  <i class={`fas fa-${s.icono} fs-5`}></i>
                </div>
              </div>
              <div>
                <h2 class="h3 fw-bold mb-3" style="margin-top: 0.25rem;">{s.titulo}</h2>
                {s.parrafos.map(p => (
                  <p class="text-muted">{p}</p>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- Capacidades -->
  <section class="section-dark section-padding" data-aos="fade-up">
    <div class="container">
      <h2 class="section-title text-white">Capacidades</h2>
      <div class="row g-4">
        {historiaPage.capacidades.map(c => (
          <div class="col-6 col-lg-3">
            <div class="text-center p-3">
              <div class="d-flex align-items-center justify-content-center mx-auto mb-3 rounded-circle bg-gold" style="width: 64px; height: 64px;">
                <i class={`fas fa-${c.icono} fs-4 text-green-dark`}></i>
              </div>
              <h3 class="h6 fw-bold text-white">{c.titulo}</h3>
              <p class="small text-white-50 mb-0">{c.descripcion}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cobertura -->
  <section class="section-padding" data-aos="fade-up">
    <div class="container">
      <h2 class="section-title">Cobertura Nacional</h2>
      <div class="row g-3 justify-content-center">
        {historiaPage.cobertura.map(c => (
          <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 p-3">
              <div class="d-flex align-items-center gap-3">
                <i class="fas fa-map-marker-alt fs-3" style="color: #1f422c;"></i>
                <div>
                  <h3 class="h6 fw-bold mb-1">{c.zona}</h3>
                  <p class="small text-muted mb-0">{c.estados}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-tech section-padding text-center" data-aos="fade-up">
    <div class="container">
      <h2 class="section-title text-white">¿Listo para trabajar juntos?</h2>
      <p class="text-white mb-4">Descubre cómo nuestros híbridos pueden impulsar tu próxima cosecha.</p>
      <a href={getUrl('/hibridos')} class="btn btn-gold btn-lg me-2">Explorar híbridos</a>
      <a href={getUrl('/hablemos')} class="btn btn-outline-light btn-lg">Solicitar cotización</a>
    </div>
  </section>
</BaseLayout>
