---
import BaseLayout from '../layouts/BaseLayout.astro'
import { zones } from '../data/zones'
import { getUrl } from '../utils/url'
---

<BaseLayout
  title="Zonas"
  description="Conoce las zonas agrícolas que cubrimos: Bajío, Occidente, Pacífico, Centro y Norte."
  breadcrumbs={[{ label: 'Zonas' }]}
>
  <section class="section-padding pb-0">
    <div class="container">
      <h1 class="section-title">ZONAS AGRÍCOLAS</h1>
      <p class="lead text-center mb-0">Cubrimos las principales regiones maiceras de México con híbridos especialmente adaptados.</p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container">
      <div class="row g-4">
        {zones.map(z => (
          <div class="col-lg-6">
            <div class="card border-0 shadow-sm overflow-hidden">
              <div class="row g-0">
                <div class="col-md-5">
                  <div class="h-100 zone-card-image" style={`background-image: url('${getUrl(z.imagen)}'); min-height: 200px;`}></div>
                </div>
                <div class="col-md-7">
                  <div class="card-body">
                    <h3 class="h5 fw-bold mb-2" style={`color: ${z.color}`}>{z.nombre}</h3>
                    <p class="small text-muted mb-3">{z.descripcion}</p>
                    <a href={getUrl(`/hibridos?zona=${z.id}`)} class="btn btn-sm btn-outline-success">
                      Ver {z.hybridIds.length} híbridos
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
